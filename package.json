{
  "name": "today-nonstop",
  "version": "1.4.1",
  "description": "A medieval time-loop comedy told as an interactive mobile conversation.",
  "author": "Bryant James",
  "license": "MIT",
  "homepage": "https://today-nonstop.bryantjames.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/the-jolly-green-bryant/today-nonstop.git"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "typecheck": "tsc --noEmit --project tsconfig.app.json",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "sync:android": "npm run build && cap sync android"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.26",
    "@angular/common": "^20.3.26",
    "@angular/core": "^20.3.26",
    "@angular/forms": "^20.3.26",
    "@angular/platform-browser": "^20.3.26",
    "@angular/platform-browser-dynamic": "^20.3.26",
    "@angular/router": "^20.3.26",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/angular": "^8.8.15",
    "@ionic/storage-angular": "^4.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.32",
    "@angular/build": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler": "^20.3.26",
    "@angular/compiler-cli": "^20.3.26",
    "@angular/language-service": "^20.3.26",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.5",
    "@ionic/angular-toolkit": "^12.3.0",
    "@types/jasmine": "^5.1.9",
    "@types/node": "^22.19.15",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.5",
    "jasmine-core": "^5.11.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "prettier": "^3.9.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
