    "dialog": {
        "010a__wakeup": {
            "speaker": "player",
            "dialog": [
                "[[ADD_ITEM]]started_day",
                "[[SHOW_KEYED_IMAGE]]debug_thunderstorm",
                "[[SET_SPEAKER]]player",
                "**grumble**",
                "What day is it?",
                "[[EMOTE]][Your stomach demands attentions.]"
            ],
            "skip_to_if": {
                "finished_once": {
                    "target": "010b__wakeup_repeat",
                    "minimum_quantity": 1,
                    "consumes_item": false
                }
            },
            "next": {
                "020a__eat_breakfast": {
                    "title": "Get some breakfast",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I'm starving!",
                        "Let's get some breakfast before we start chores."
                    ]
                },
                "030a__start_chores": {
                    "title": "No time for breakfast, gotta start work.",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "No time for breakfast, gotta start work.",
                        "I'll just take some bread with me to snack on.",
                        "[[FLASH_ITEM]]debug_bread",
                        "[[ADD_ITEM]]debug_bread",
                        "[[ADD_ITEM]]debug_bread",
                        "This might come in handy"
                    ]
                }
            },
            "show_in_editor": false
        },
        "010b__wakeup_repeat": {
            "speaker": "player",
            "dialog": [
                "[[CLEAR_INVENTORY]]",
                "[[SHOW_KEYED_IMAGE]]debug_thunderstorm",
                "[[SET_SPEAKER]]player",
                "Heavy storm two mornings in a row. Strange. Or a",
                "[[FLASH_KEYED_IMAGE]]debug_breakfast",
                "[[SET_SPEAKER]]evil_voice",
                "[[FLASH_KEYED_IMAGE]]debug_breakfast",
                "[[SET_SPEAKER]]player",
                "I'm the player",
                "[[SHOW_KEYED_IMAGE]]debug_thunderstorm",
                "[[SET_SPEAKER]]player",
                "I'm still the player"
            ],
            "next": {
                "020a__eat_breakfast": {
                    "title": "Let's get some breakfast before starting chores",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I'm starving!",
                        "Let's get some breakfast before we start chores."
                    ]
                },
                "030a__start_chores": {
                    "title": "No time for breakfast, gotta start work.",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "No time for breakfast, gotta start work.",
                        "I'll just take some bread with me to snack on.",
                        "[[FLASH_ITEM]]debug_bread",
                        "[[ADD_ITEM]]debug_bread"
                    ]
                },
                "050a__skip_day": {
                    "title": "Skip today until we've skipped 5 times.",
                    "dialog": [
                        "How many times are we going to do this?"
                    ]
                },
                "060__restart": {
                    "title": "Go to restart",
                    "dialog": []
                }
            },
            "comment": "Is this strange?",
            "show_in_editor": true
        },
        "020a__eat_breakfast": {
            "speaker": "player",
            "dialog": [
                "[[SHOW_KEYED_IMAGE]]debug_breakfast",
                "[[SET_SPEAKER]]player",
                "This breakfast is delicious.",
                "It's pretty legit.",
                "I dig it."
            ],
            "next": {
                "030a__start_chores": {
                    "dialog": [
                        "[[DELAY]]2.5",
                        "Whelp, guess it's time to start work"
                    ]
                }
            }
        },
        "030a__start_chores": {
            "speaker": "player",
            "dialog": [
                "[[SET_SPEAKER]]evil_voice",
                "This sucks, you should stop working"
            ],
            "next": {
                "010a__wakeup": {
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I don't think that bread is so good...",
                        "[[EMOTE]]You suddenly pass out",
                        "[[ADD_ITEM]]finished_once"
                    ],
                    "title": "Eat Moldy Bread",
                    "show_if": [
                        "moldy_bread",
                        "finished_once"
                    ]
                },
                "040a__process_restart": {
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "You're right, voice-in-my-head! Let's stop.",
                        "[[MODIFY_REP:2]]evil_voice"
                    ],
                    "title": "Stop Working"
                },
                "030a__start_chores": {
                    "title": "Keep Working",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I need to silence the voice and keep working.",
                        "[[MODIFY_REP:-2]]evil_voice"
                    ]
                }
            },
            "show_in_editor": true
        },
        "040a__process_restart": {
            "comment": "This blank room redirects us to some other blank rooms to convert regular items into aged items",
            "speaker": "player",
            "dialog": [],
            "skip_to_if": {
                "debug_bread": {
                    "target": "041a__process_aged_bread",
                    "minimum_quantity": 1,
                    "consumes_item": true
                }
            },
            "next": {
                "010a__wakeup": {
                    "dialog": [
                        "[[EMOTE]]You suddenly pass out",
                        "[[ADD_ITEM]]finished_once"
                    ]
                }
            }
        },
        "041a__process_aged_bread": {
            "comment": "This blank room turns regular bread into moldy bread",
            "speaker": "player",
            "dialog": [
                "[[ADD_ITEM]]moldy_bread"
            ],
            "next": {
                "040a__process_restart": {
                    "dialog": []
                }
            }
        },
        "050a__skip_day": {
            "comment": "Skip today until we've skipped 5 times.",
            "speaker": null,
            "dialog": [
                "[[EMOTE]]You suddenly pass out"
            ],
            "next": {
                "040a__process_restart": {
                    "title": "",
                    "dialog": []
                }
            },
            "skip_to_if": {
                "finished_once": {
                    "consumes_item": false,
                    "minimum_quantity": 5,
                    "target": "050b__skip_day__stop"
                }
            }
        },
        "050b__skip_day__stop": {
            "comment": "Stop Skipping",
            "speaker": "player",
            "dialog": [
                "You can't skip anymore. We're restarting the day now."
            ],
            "next": {
                "010a__wakeup": {
                    "title": null,
                    "dialog": []
                }
            }
        },
        "060__restart": {
            "comment": "Restart",
            "speaker": "player",
            "dialog": [
                "Restarting",
                "[[RESTART]]"
            ],
            "next": {},
            "show_in_editor": true
        }
    }
