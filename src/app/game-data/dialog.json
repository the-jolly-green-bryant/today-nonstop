{
    "default_scene": "wakeup",
    "characters": {
        "player": {
            "avatar": "https://via.placeholder.com/150",
            "name": "I'm the player!"
        },
        "evil_voice": {
            "avatar": "https://via.placeholder.com/150",
            "name": "Player's evil voice"
        }
    },
    "items": {
        "debug_bread": {
            "avatar": "https://bluezephyrapps-app-resources.s3.amazonaws.com/app_resources/today_nonstop/da2abda1-fae1-4782-b65f-93868ca5bd40.jpeg",
            "name": "Debug Bread"
        },
        "moldy_bread": {
            "avatar": "https://bluezephyrapps-app-resources.s3.amazonaws.com/app_resources/today_nonstop/da2abda1-fae1-4782-b65f-93868ca5bd40.jpeg",
            "name": "Moldy Bread"
        },
        "started_day": {
            "hidden": true
        },
        "finished_once": {
            "avatar": "https://bluezephyrapps-app-resources.s3.amazonaws.com/app_resources/today_nonstop/da2abda1-fae1-4782-b65f-93868ca5bd40.jpeg",
            "name": "Days Completed",
            "always_show_chip": true,
            "is_status": true
        }
    },
    "keyed_images": {
        "debug_thunderstorm": "https://bluezephyrapps-app-resources.s3.amazonaws.com/app_resources/today_nonstop/rainy-window-2-15-2014-4-47-19-pm.jpeg",
        "debug_breakfast": "https://bluezephyrapps-app-resources.s3.amazonaws.com/app_resources/today_nonstop/360_F_247199107_3W9Clvj0lRf2z1g5wx206ybAccczNd9H.jpeg"
    },
    "dialog": {
        "wakeup": {
            "speaker": "player",
            "dialog": [
                "[[ADD_ITEM]]started_day",
                "[[SHOW_KEYED_IMAGE]]debug_thunderstorm",
                "[[SET_SPEAKER]]player",
                "**grumble**",
                "What day is it?",
                "[[EMOTE]][Your stomach demands attentions.]"
            ],
            "skip_to_if": {
                "finished_once": {
                    "target": "wakeup_repeat",
                    "minimum_quantity": 1,
                    "consumes_item": false
                }
            },
            "next": {
                "eat_breakfast": {
                    "title": "Get some breakfast",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I'm starving!",
                        "Let's get some breakfast before we start chores."
                    ]
                },
                "start_chores": {
                    "title": "No time for breakfast, gotta start work.",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "No time for breakfast, gotta start work.",
                        "I'll just take some bread with me to snack on.",
                        "[[FLASH_ITEM]]debug_bread",
                        "[[ADD_ITEM]]debug_bread",
                        "[[ADD_ITEM]]debug_bread",
                        "This might come in handy"
                    ]
                }
            }
        },
        "wakeup_repeat": {
            "speaker": "player",
            "dialog": [
                "[[SHOW_KEYED_IMAGE]]debug_thunderstorm",
                "[[SET_SPEAKER]]player",
                "Heavy storm two mornings in a row. Strange. Or a"
            ],
            "next": {
                "eat_breakfast": {
                    "title": "Let's get some breakfast before starting chores",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I'm starving!",
                        "Let's get some breakfast before we start chores."
                    ]
                },
                "start_chores": {
                    "title": "No time for breakfast, gotta start work.",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "No time for breakfast, gotta start work.",
                        "I'll just take some bread with me to snack on.",
                        "[[FLASH_ITEM]]debug_bread",
                        "[[ADD_ITEM]]debug_bread"
                    ]
                },
                "skip_day": {
                    "title": "Skip today until we've skipped 5 times.",
                    "dialog": [
                        "How many times are we going to do this?"
                    ]
                }
            },
            "comment": "Is this strange?"
        },
        "eat_breakfast": {
            "speaker": "player",
            "dialog": [
                "[[SHOW_KEYED_IMAGE]]debug_breakfast",
                "[[SET_SPEAKER]]player",
                "This breakfast is delicious.",
                "It's pretty legit.",
                "I dig it."
            ],
            "next": {
                "start_chores": {
                    "dialog": [
                        "[[DELAY]]2.5",
                        "Whelp, guess it's time to start work"
                    ]
                }
            }
        },
        "start_chores": {
            "speaker": "player",
            "dialog": [
                "[[SET_SPEAKER]]evil_voice",
                "This sucks, you should stop working"
            ],
            "next": {
                "process_restart": {
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "You're right, voice-in-my-head! Let's stop.",
                        "[[MODIFY_REP:2]]evil_voice"
                    ],
                    "title": "Stop Working"
                },
                "start_chores": {
                    "title": "Keep Working",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I need to silence the voice and keep working.",
                        "[[MODIFY_REP:-2]]evil_voice"
                    ]
                }
            }
        },
        "process_restart": {
            "comment": "This blank room redirects us to some other blank rooms to convert regular items into aged items",
            "speaker": "player",
            "dialog": [],
            "skip_to_if": {
                "debug_bread": {
                    "target": "process_aged_bread",
                    "minimum_quantity": 1,
                    "consumes_item": true
                }
            },
            "next": {
                "wakeup": {
                    "dialog": [
                        "[[EMOTE]]You suddenly pass out",
                        "[[ADD_ITEM]]finished_once"
                    ]
                }
            }
        },
        "process_aged_bread": {
            "comment": "This blank room turns regular bread into moldy bread",
            "speaker": "player",
            "dialog": [
                "[[ADD_ITEM]]moldy_bread"
            ],
            "next": {
                "process_restart": {
                    "dialog": []
                }
            }
        },
        "skip_day": {
            "comment": "Skip today until we've skipped 5 times.",
            "speaker": null,
            "dialog": [
                "[[EMOTE]]You suddenly pass out"
            ],
            "next": {
                "process_restart": {
                    "title": "",
                    "dialog": []
                }
            },
            "skip_to_if": {
                "finished_once": {
                    "consumes_item": false,
                    "minimum_quantity": 5,
                    "target": "skip_day__stop"
                }
            }
        },
        "skip_day__stop": {
            "comment": "Stop Skipping",
            "speaker": "player",
            "dialog": [
                "You can't skip anymore. We're restarting the day now."
            ],
            "next": {
                "wakeup": {
                    "title": null,
                    "dialog": []
                }
            }
        }
    }
}