    "dialog": {
        "010a__wakeup": {
            "speaker": "player",
            "dialog": [
                "[[ADD_ITEM]]started_day",
                "[[SHOW_KEYED_IMAGE]]debug_thunderstorm",
                "[[SET_SPEAKER]]player",
                "**grumble**",
                "What day is it?",
                "[[EMOTE]][Your stomach demands attentions.]"
            ],
            "skip_to_if": {
                "finished_once": {
                    "target": "010b__wakeup_repeat",
                    "minimum_quantity": 1,
                    "consumes_item": false
                }
            },
            "next": {
                "020a__eat_breakfast": {
                    "title": "Get some breakfast",
                    "dialog": [
                        "[[SET_SPEAKER]]player",
                        "I'm starving!",
                        "Let's get some breakfast before we start chores."
                    ]
